{
  "name": "mon-app-ia",
  "private": true,
  "description": "Next.js (frontend) + Node.js/Express (backend) + MongoDB",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "npm run install:all && node scripts/setup-env.js",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "dev": "concurrently -n back,front -c blue,green \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:back": "npm run dev --prefix backend",
    "dev:front": "npm run dev --prefix frontend",
    "db:check": "npm run db:check --prefix backend",
    "lint": "npm run lint --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
