PORT=5000
CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/senior-assistant

# Sécurité : changez cette valeur (chaîne longue et aléatoire)
JWT_SECRET=change-moi-par-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=7d

# Services IA (offres gratuites). Sans clé, la passerelle bascule
# sur le générateur local afin que l'application reste utilisable.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Alertes Telegram (optionnel) : jeton du bot créé avec @BotFather
TELEGRAM_BOT_TOKEN=
